#!/usr/bin/env sh
# gem-publish

# 20261022
# 0.5.0

built=0
otp=''
here=$(pwd)

check_clean() {
  local directory changes dirty=0
  for directory in "$@"; do
    changes=$(git -C "$directory" status --porcelain 2>&1) && [ -z "$changes" ] && continue
    if [ "$dirty" -eq 0 ]; then
      echo 'gem-publish: Nothing built or pushed. There are files that need to be committed first:' >&2
      dirty=1
    fi
    printf '%s\n%s\n' "$directory" "$changes" >&2
  done
  [ "$dirty" -eq 0 ]
}

build_gems() {
  local directory
  for directory in "$@"; do
    cd "$directory" || continue
    chmod -R a+rX .
    for gemspec in *.gemspec; do
      gem build "$gemspec" && built=$((built + 1))
    done
    cd "$here" || exit 1
  done
}

read_otp() {
  printf 'OTP code (leave blank to be asked for each gem): '
  read otp
}

push_gems() {
  local directory
  for directory in "$@"; do
    cd "$directory" || continue
    for gem in *.gem; do
      if [ -n "$otp" ]; then
        gem push --otp "$otp" "$gem"
      else
        gem push "$gem"
      fi
    done
    rm *.gem
    cd "$here" || exit 1
  done
}

main() {
  [ "$#" -eq 0 ] && set -- .
  check_clean "$@" || exit 1
  build_gems "$@"
  if [ "$built" -gt 1 ]; then
    read_otp
  fi
  push_gems "$@"
}

main "$@"
