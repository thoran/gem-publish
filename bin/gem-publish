#!/usr/bin/env sh
# gem-publish

# 20261027
# 0.5.1

built=0
otp=''
here=$(pwd)

built_from_status() {
  ruby - <<'RUBY'
require 'pathname'
require 'stringio'
gemspecs = Dir['*.gemspec']
abort 'No gemspec.' if gemspecs.empty?
top = `git rev-parse --show-toplevel`.chomp
exit 1 unless $?.success?
paths = []
read = []
recording = false
IO.singleton_class.prepend(Module.new do
  %i{binread foreach open read readlines}.each do |method_name|
    define_method(method_name) do |path, *args, **options, &block|
      read << File.expand_path(path) if recording && (path.is_a?(String) || path.respond_to?(:to_path))
      super(path, *args, **options, &block)
    end
  end
end)
gemspecs.each do |gemspec|
  features = $LOADED_FEATURES.dup
  $stdout = $stderr = StringIO.new
  recording = true
  spec = Gem::Specification.load(File.expand_path(gemspec))
  recording = false
  output, $stdout, $stderr = $stdout.string, STDOUT, STDERR
  abort output + "#{gemspec} didn't load." unless spec
  paths.concat(spec.files.map{|file| File.expand_path(file)})
  paths << File.expand_path(gemspec)
  paths.concat($LOADED_FEATURES - features)
end
paths.concat(read)
here = Pathname.pwd
paths = paths.uniq.select{|path| path.start_with?(top + '/')}.map{|path| Pathname(path).relative_path_from(here).to_s}
exec('git', '--literal-pathspecs', 'status', '--porcelain', '--', *paths)
RUBY
}

check_clean() {
  local directory changes dirty=0
  for directory in "$@"; do
    changes=$(cd "$directory" 2>&1 && built_from_status 2>&1) && [ -z "$changes" ] && continue
    if [ "$dirty" -eq 0 ]; then
      echo 'gem-publish: Nothing built or pushed. There are files that need to be committed first:' >&2
      dirty=1
    fi
    printf '%s\n%s\n' "$directory" "$changes" >&2
  done
  [ "$dirty" -eq 0 ]
}

build_gems() {
  local directory
  for directory in "$@"; do
    cd "$directory" || continue
    chmod -R a+rX .
    for gemspec in *.gemspec; do
      gem build "$gemspec" && built=$((built + 1))
    done
    cd "$here" || exit 1
  done
}

read_otp() {
  printf 'OTP code (leave blank to be asked for each gem): '
  read otp
}

push_gems() {
  local directory
  for directory in "$@"; do
    cd "$directory" || continue
    for gem in *.gem; do
      if [ -n "$otp" ]; then
        gem push --otp "$otp" "$gem"
      else
        gem push "$gem"
      fi
    done
    rm *.gem
    cd "$here" || exit 1
  done
}

main() {
  [ "$#" -eq 0 ] && set -- .
  check_clean "$@" || exit 1
  build_gems "$@"
  if [ "$built" -gt 1 ]; then
    read_otp
  fi
  push_gems "$@"
}

main "$@"
