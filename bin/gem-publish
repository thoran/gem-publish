#!/usr/bin/env sh
# gem-publish

# 20260828
# 0.3.0

built=0
otp=''

build_gems() {
  for gemspec in *.gemspec; do
    gem build "$gemspec" && built=$((built + 1))
  done
}

read_otp() {
  printf 'OTP code (leave blank to be asked for each gem): '
  read otp
}

push_gems() {
  for gem in *.gem; do
    if [ -n "$otp" ]; then
      gem push --otp "$otp" "$gem"
    else
      gem push "$gem"
    fi
  done
}

main() {
  chmod -R a+rX .
  build_gems
  if [ "$built" -gt 1 ]; then
    read_otp
  fi
  push_gems
  rm *.gem
}

main "$@"
