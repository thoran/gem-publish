#!/usr/bin/env sh
# gem-publish

# 20260908
# 0.4.0

built=0
otp=''
here=$(pwd)

build_gems() {
  local directory
  for directory in "$@"; do
    cd "$directory" || continue
    chmod -R a+rX .
    for gemspec in *.gemspec; do
      gem build "$gemspec" && built=$((built + 1))
    done
    cd "$here" || exit 1
  done
}

read_otp() {
  printf 'OTP code (leave blank to be asked for each gem): '
  read otp
}

push_gems() {
  local directory
  for directory in "$@"; do
    cd "$directory" || continue
    for gem in *.gem; do
      if [ -n "$otp" ]; then
        gem push --otp "$otp" "$gem"
      else
        gem push "$gem"
      fi
    done
    rm *.gem
    cd "$here" || exit 1
  done
}

main() {
  [ "$#" -eq 0 ] && set -- .
  build_gems "$@"
  if [ "$built" -gt 1 ]; then
    read_otp
  fi
  push_gems "$@"
}

main "$@"
